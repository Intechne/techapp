# Public client configuration only. NEVER put the service role key, signing secrets or passwords here:
# everything prefixed EXPO_PUBLIC_ is compiled into the app bundle.
# Copy to .env.local (local) or set per EAS environment (development / preview / production).
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Dashboard → Settings → API Keys → Publishable key (sb_publishable_…). Never the secret / service_role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Crash reporting (Sentry), optional. Empty = OFF (no SDK start, no network). Public DSN only, never a secret key or the
# auth token. Set per EAS environment; production and development use different projects. docs/CRASH-REPORTING.md
EXPO_PUBLIC_SENTRY_DSN=
